# ============================================================
#  ITAC — configuration. Copiez ce fichier en .env puis adaptez.
#  En production : APP_ENV=production et APP_DEBUG=false (obligatoire).
# ============================================================
APP_NAME="ITAC Gestion"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gestion.itac.edu.ht
APP_TIMEZONE=America/Port-au-Prince

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Établissement (affiché sur les bulletins et reçus)
ITAC_NOM="Institut de Technologies Appliquées des Cayes"
ITAC_SIGLE=ITAC
ITAC_ADRESSE="Les Cayes, Haïti"
ITAC_TELEPHONE=
ITAC_EMAIL=
# Pondération de la moyenne d'un cours (en %)
ITAC_POIDS_INTRA=40
ITAC_POIDS_FINAL=60

# Journaux : un fichier par jour, 14 jours conservés
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Base de données (MySQL / MariaDB recommandé en production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=itac
DB_USERNAME=itac
DB_PASSWORD=

# Ancienne base (uniquement pour « php artisan itac:importer-ancienne-base »)
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=itac_db
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

# Sessions : stockées en base, chiffrées ; cookie sécurisé si HTTPS
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Si l'application est derrière un proxy / Cloudflare : TRUSTED_PROXIES=*
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@itac.edu.ht"
MAIL_FROM_NAME="${APP_NAME}"
